+BASE_URL = os.environ.get("OPENAI_BASE_URL", "https://api.openai.com/v1")
+
+
+# --- model_test 로컬 수정: 서빙 백엔드 제약 (SERVING_* env) ---------------
+# shared/serving/constraints.py 와 같은 규약. 이 파일은 외부 repo(data/KRETA)
+# 안에 있어 shared/ 를 import 하면 경로/재현성이 취약하므로 env 만 직접 읽는
+# self-contained 구현으로 둔다. env 미설정 시 완전 no-op.
+#
+# 필요한 이유: diffusion 백엔드(DiffusionGemma 등 canvas_length 를 가진 dLLM)는
+#   - temperature/min_p/seed/min_tokens/logit_bias/bad_words/allowed_token_ids
+#     를 보내면 vllm/sampling_params.py 의 _validate_diffusion 이 400 을 낸다
+#   - skip_special_tokens 기본값(True)이면 chat completions 응답의 content 가
+#     None 으로 온다 (Gemma4 파서가 디토크나이즈된 문자열에서 경계를 못 찾음).
+def _apply_serving_constraints(kwargs):
+    for name in os.environ.get("SERVING_UNSUPPORTED_SAMPLING_PARAMS", "").split(","):
+        name = name.strip()
+        if name:
+            kwargs.pop(name, None)
+
+    cap_raw = os.environ.get("SERVING_MAX_OUTPUT_TOKENS", "").strip()
+    if cap_raw:
+        try:
+            cap = int(cap_raw)
+        except ValueError:
+            cap = 0
+        current = kwargs.get("max_tokens")
+        if cap > 0 and isinstance(current, int) and current > cap:
+            kwargs["max_tokens"] = cap
+
+    skip_raw = os.environ.get("SERVING_FORCE_SKIP_SPECIAL_TOKENS", "").strip().lower()
+    if skip_raw in ("false", "0", "no", "true", "1", "yes"):
+        extra = kwargs.get("extra_body")
+        if not isinstance(extra, dict):
+            extra = {}
+            kwargs["extra_body"] = extra
+        # skip_special_tokens 는 OpenAI 표준 파라미터가 아니라 extra_body 로 보낸다.
+        extra["skip_special_tokens"] = skip_raw in ("true", "1", "yes")
+
+    return kwargs
+# --- 로컬 수정 끝 ---------------------------------------------------------
 
