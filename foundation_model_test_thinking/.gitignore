# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python

# Virtualenvs
.venv/
venv/
env/

# Evaluation session / outputs (재현 시 자동 재생성)
.eval_session
logs/
.judge_input/

# External benchmark repos (install.sh 가 clone — 재현은 SHA 핀으로)
data/

# Editor / OS
.DS_Store
*.swp
*.tmp

# Claude Code 세션 메타
.claude/

# Secrets (env vars)
.env

# Backups (롤백용, push 안 함)
*.bak
*.bak.*
*_bak
*.jinja_bak

# tau2 의 --llm-log-mode all 이 LLM 호출마다 요청/응답 전문을 덤프한다.
# 40태스크 런 하나가 3,270개 파일 / 100MB+ 를 만든다. 진단에는 유용하므로 디스크에는
# 남기되 버전관리에서는 뺀다. 채점에 필요한 것은 results.json / task.log / sim_status.json 이다.
llm_debug/

# tau2 는 태스크마다 대화 궤적을 남긴다 (런당 ~80개 파일). 진단에는 쓰지만
# 버전관리 대상은 아니다 — 재집계에 필요한 것은 upstream/<domain>/results.json 하나이며
# 거기에 태스크별 보상이 전부 들어 있다.
results/*/*/language/*/upstream/*/artifacts/
